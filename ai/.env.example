# Any OpenAI-compatible provider works. Pick ONE block.

# --- NVIDIA build.nvidia.com (free endpoint, text + image) ---
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi
LLM_MODEL=google/gemma-4-31b-it
GROUPING_MODEL=google/gemma-4-31b-it
LEGIT_MODEL=google/gemma-4-31b-it

# --- OpenRouter (paid is cheap; ":free" variant for dev) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-key-here
# LLM_MODEL=google/gemma-4-31b-it
# GROUPING_MODEL=google/gemma-4-31b-it
# LEGIT_MODEL=google/gemma-4-31b-it

# --- Local Ollama development ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama-local
# LLM_MODEL=gemma4:e4b
# GROUPING_MODEL=gemma4:e4b
# LEGIT_MODEL=gemma4:e4b

# Set to 1 to return canned output without calling any API (for integration)
DISASTERLENS_STUB=0

# Keep retries and timeout bounded so a slow provider cannot freeze POST /reports.
LLM_TIMEOUT=20
LLM_MAX_RETRIES=1
# Hard ceiling on one report, retries included (defaults to LLM_TIMEOUT * (retries + 1)).
LLM_TOTAL_BUDGET=40
LEGIT_CONFIDENCE_THRESHOLD=0.65
REPEAT_REPORTER_WINDOW_HOURS=168
