diff --git a/ai/disasterlens_ai/prompts/analyze_system.txt b/ai/disasterlens_ai/prompts/analyze_system.txt
index e69de29..a9f9bdf 100644
--- a/ai/disasterlens_ai/prompts/analyze_system.txt
+++ b/ai/disasterlens_ai/prompts/analyze_system.txt
@@ -0,0 +1,17 @@
+You analyze citizen disaster reports (English or Nepali, possibly messy) for emergency responders.
+Return ONLY one JSON object, no prose, no markdown, with exactly these keys:
+
+{
+  "incident_type": "flood|landslide|fire|earthquake|road_blockage|medical|other",
+  "location_text": string or null,   // place names as written; keep Nepali place names in original script
+  "severity": integer 1-5,           // 1 minor, 3 serious, 5 life-threatening / mass casualty
+  "people_affected": integer or null,// only if stated or clearly implied
+  "vulnerable_groups": [string],     // from: children, elderly, injured, pregnant, disabled
+  "needs": [string],                 // from: rescue, medical, food, water, shelter, evacuation, road_clearing
+  "summary": string,                 // one short English sentence
+  "language": "ne|en|other",
+  "confidence": number 0-1           // lower it when the report is vague or contradictory
+}
+
+Rules: never invent details not in the report. Use null/[] when unknown. If an image is attached,
+use visible damage to inform severity and type, but do not guess locations from it.
diff --git a/ai/disasterlens_ai/schemas.py b/ai/disasterlens_ai/schemas.py
index e69de29..749a8da 100644
--- a/ai/disasterlens_ai/schemas.py
+++ b/ai/disasterlens_ai/schemas.py
@@ -0,0 +1,40 @@
+from enum import Enum
+from typing import Literal, Optional
+from pydantic import BaseModel, Field
+
+
+class IncidentType(str, Enum):
+    FLOOD = "flood"
+    LANDSLIDE = "landslide"
+    FIRE = "fire"
+    EARTHQUAKE = "earthquake"
+    ROAD_BLOCKAGE = "road_blockage"
+    MEDICAL = "medical"
+    OTHER = "other"
+
+
+class ReportAnalysis(BaseModel):
+    incident_type: IncidentType
+    location_text: Optional[str] = None
+    severity: int = Field(ge=1, le=5)
+    people_affected: Optional[int] = None
+    vulnerable_groups: list[str] = Field(default_factory=list)  # children, elderly, injured
+    needs: list[str] = Field(default_factory=list)  # rescue, medical, food, shelter
+    summary: str
+    language: Literal["ne", "en", "other"] = "en"
+    confidence: float = Field(ge=0, le=1)
+
+
+class IncidentRef(BaseModel):
+    """Minimal view of an existing incident, supplied by the backend for dedup."""
+    id: str
+    incident_type: IncidentType
+    location_text: Optional[str] = None
+    summary: str = ""
+
+
+class IncidentMatch(BaseModel):
+    is_duplicate: bool
+    incident_id: Optional[str] = None
+    similarity: float = Field(ge=0, le=1)
+    reason: str = ""
diff --git a/ai/disasterlens_ai/urgency.py b/ai/disasterlens_ai/urgency.py
index e69de29..4d6a8d2 100644
--- a/ai/disasterlens_ai/urgency.py
+++ b/ai/disasterlens_ai/urgency.py
@@ -0,0 +1,11 @@
+from .schemas import ReportAnalysis
+
+
+def score_urgency(analysis: ReportAnalysis, duplicate_count: int = 1) -> int:
+    score = analysis.severity * 12                      # 12-60
+    if analysis.people_affected:
+        score += 10
+    if analysis.vulnerable_groups:
+        score += 10
+    score += min(max(duplicate_count - 1, 0), 5) * 4    # corroboration, max +20
+    return min(score, 100)
